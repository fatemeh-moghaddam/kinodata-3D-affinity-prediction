universe = docker
docker_image = gjoschka/kinodata3d-pt2.5.1-cu121-cudnn9
executable = run_prob.sh
arguments = $(script) $(split) $(rmsd) $(gnn)
output = run_prob.$(ClusterId).$(ProcId).out
error = run_prob.$(ClusterId).$(ProcId).err
log = run_prob.$(ClusterId).log
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
request_GPUs = 1
request_CPUs = 32
request_memory = 64G
requirements = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted = true
queue script, split, rmsd, gnn from (
   run_prob, random-k-fold, 2, CGNN-3D
   run_prob, scaffold-k-fold, 2, CGNN-3D
   run_prob, pocket-k-fold, 2, CGNN-3D
)