universe = docker
docker_image = gjoschka/kinodata3d-b0:2.3.0-cuda12.1
executable = run_prob.sh
arguments = $(script) $(split) $(rmsd) $(gnn) $(target)
output = run_prob.$(ClusterId).$(ProcId).out
error = run_prob.$(ClusterId).$(ProcId).err
log = run_prob.$(ClusterId).log
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
request_GPUs = 1
request_CPUs = 64
request_memory = 64G
requirements = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted = true
queue script, split, rmsd, gnn, target from (
   prob_models_and_run, random-k-fold, 2, CGNN-3D, nitrogen_counts.pt
)