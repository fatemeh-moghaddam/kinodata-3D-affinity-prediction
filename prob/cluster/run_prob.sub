universe = docker
docker_image = gjoschka/kinodata3d-b0:2.3.0-cuda12.1
executable = run_prob.sh
output = probe_aff_ds_affinity.$(ClusterId).$(ProcId).out
error = probe_aff_ds_affinity.$(ClusterId).$(ProcId).err
log = probe_aff_ds_affinity.$(ClusterId).log
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
request_GPUs = 1
request_CPUs = 16
request_memory = 32G
# requirements = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted = true

# run_linear/run_nonlinear/run_baseline/nonlinear_models are forwarded by run_prob.sh as
# PROB_RUN_LINEAR_MODELS / PROB_RUN_NON_LINEAR_MODELS / PROB_RUN_SHUFFLED_BASELINE /
# PROB_NONLINEAR_MODELS env vars for prob_orchestrate.main() -- one job runs everything
# requested for its target (linear, non-linear subset, baseline) in a single process/wandb run.
arguments = $(script) $(split) $(rmsd) $(gnn) $(target) $(run_linear) $(run_nonlinear) $(run_baseline) $(nonlinear_models)
# Job list = cross product of the loops in run_prob_jobs.sh (edit the arrays there).
# Preview it with `bash run_prob_jobs.sh`, or `condor_submit -dry-run - run_prob.sub`.
queue script, split, rmsd, gnn, target, run_linear, run_nonlinear, run_baseline, nonlinear_models from bash run_prob_jobs.sh |
