universe = docker
docker_image = gjoschka/kinodata3d-b0:2.3.0-cuda12.1
executable = run_prob.sh
output = probe_aff_ds_hbond_score_no_mw.$(ClusterId).$(ProcId).out
error = probe_aff_ds_hbond_score_no_mw.$(ClusterId).$(ProcId).err
log = probe_aff_ds_hbond_score_no_mw.$(ClusterId).log
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
request_GPUs = 1
request_CPUs = 16
request_memory = 32G
# requirements = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted = true

# run_linear/run_nonlinear/run_baseline/nonlinear_models are forwarded by run_prob.sh as
# PROB_RUN_LINEAR_MODELS / PROB_RUN_NON_LINEAR_MODELS / PROB_RUN_SHUFFLED_BASELINE /
# PROB_NONLINEAR_MODELS env vars for prob_orchestrate.main() -- one job runs everything
# requested for its target (linear, non-linear subset, baseline) in a single process/wandb run.
arguments = $(script) $(split) $(rmsd) $(gnn) $(target) $(run_linear) $(run_nonlinear) $(run_baseline) $(nonlinear_models)
queue script, split, rmsd, gnn, target, run_linear, run_nonlinear, run_baseline, nonlinear_models from (
   prob_orchestrate, random-k-fold, 2, CGNN-3D, nitrogen_counts.pt, 1, 1, 1, mlp
   prob_orchestrate, random-k-fold, 2, CGNN, nitrogen_counts.pt, 1, 1, 1, mlp
   prob_orchestrate, random-k-fold, 2, DTI, nitrogen_counts.pt, 1, 1, 1, mlp
   prob_orchestrate, random-k-fold, 2, DTI, pi_stacking.pt, 1, 1, 1, mlp
   prob_orchestrate, random-k-fold, 2, CGNN, pi_stacking.pt, 1, 1, 1, mlp
   prob_orchestrate, random-k-fold, 2, CGNN-3D, pi_stacking.pt, 1, 1, 1, mlp
   prob_orchestrate, random-k-fold, 2, CGNN-3D, hbond_score_no_mw.pt, 1, 1, 1, mlp
   prob_orchestrate, random-k-fold, 2, CGNN, hbond_score_no_mw.pt, 1, 1, 1, mlp
   prob_orchestrate, random-k-fold, 2, DTI, hbond_score_no_mw.pt, 1, 1, 1, mlp
   prob_orchestrate, random-k-fold, 4, CGNN-3D, nitrogen_counts.pt, 1, 1, 1, mlp
   prob_orchestrate, random-k-fold, 4, CGNN, nitrogen_counts.pt, 1, 1, 1, mlp
   prob_orchestrate, random-k-fold, 4, DTI, nitrogen_counts.pt, 1, 1, 1, mlp
   prob_orchestrate, random-k-fold, 4, DTI, pi_stacking.pt, 1, 1, 1, mlp
   prob_orchestrate, random-k-fold, 4, CGNN, pi_stacking.pt, 1, 1, 1, mlp
   prob_orchestrate, random-k-fold, 4, CGNN-3D, pi_stacking.pt, 1, 1, 1, mlp
   prob_orchestrate, random-k-fold, 4, CGNN-3D, hbond_score_no_mw.pt, 1, 1, 1, mlp
   prob_orchestrate, random-k-fold, 4, CGNN, hbond_score_no_mw.pt, 1, 1, 1, mlp
   prob_orchestrate, random-k-fold, 4, DTI, hbond_score_no_mw.pt, 1, 1, 1, mlp
   prob_orchestrate, random-k-fold, 6, CGNN-3D, nitrogen_counts.pt, 1, 1, 1, mlp
   prob_orchestrate, random-k-fold, 6, CGNN, nitrogen_counts.pt, 1, 1, 1, mlp
   prob_orchestrate, random-k-fold, 6, DTI, nitrogen_counts.pt, 1, 1, 1, mlp
   prob_orchestrate, random-k-fold, 6, DTI, pi_stacking.pt, 1, 1, 1, mlp
   prob_orchestrate, random-k-fold, 6, CGNN, pi_stacking.pt, 1, 1, 1, mlp
   prob_orchestrate, random-k-fold, 6, CGNN-3D, pi_stacking.pt, 1, 1, 1, mlp
   prob_orchestrate, random-k-fold, 6, CGNN-3D, hbond_score_no_mw.pt, 1, 1, 1, mlp
   prob_orchestrate, random-k-fold, 6, CGNN, hbond_score_no_mw.pt, 1, 1, 1, mlp
   prob_orchestrate, random-k-fold, 6, DTI, hbond_score_no_mw.pt, 1, 1, 1, mlp
 
)
