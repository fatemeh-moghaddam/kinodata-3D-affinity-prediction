universe = docker
docker_image = gjoschka/kinodata3d-b0:2.3.0-cuda12.1
executable = run_prob.sh
arguments = $(script) $(split) $(rmsd) $(gnn)
output = extract_layer0.$(ClusterId).$(ProcId).out
error = extract_layer0.$(ClusterId).$(ProcId).err
log = extract_layer0.$(ClusterId).log
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
request_GPUs = 1
request_CPUs = 9
request_memory = 32G
requirements = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted = true
queue script, split, rmsd, gnn from (
   extract_layer0 random-k-fold 2 CGNN-3D
)