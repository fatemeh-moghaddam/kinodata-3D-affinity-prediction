universe = docker
docker_image = gjoschka/kinodata3d-pt2.5.1-cu121-cudnn9
executable = generate_prob_dataset.sh
arguments = $(script) $(split) $(rmsd) $(gnn) $(overwrite)
output = generate_scaffold_reprs.$(ClusterId).$(ProcId).out
error = generate_scaffold_reprs.$(ClusterId).$(ProcId).err
log = generate_scaffold_reprs.$(ClusterId).log
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
request_GPUs = 1
request_CPUs = 16
request_memory = 64G
+WantGPUHomeMounted = true
queue script, split, rmsd, gnn, overwrite from (ß
   run_extraction, scaffold-k-fold, 2, CGNN-3D, 1
   run_extraction, scaffold-k-fold, 2, CGNN, 1
   run_extraction, scaffold-k-fold, 2, DTI, 1
   run_extraction, scaffold-k-fold, 4, CGNN-3D, 1
   run_extraction, scaffold-k-fold, 4, DTI, 1
   run_extraction, scaffold-k-fold, 4, CGNN, 1
   run_extraction, scaffold-k-fold, 6, CGNN-3D, 1
   run_extraction, scaffold-k-fold, 6, CGNN, 1
   run_extraction, scaffold-k-fold, 6, DTI, 1
   run_extraction, pocket-k-fold, 2, CGNN-3D, 1
   run_extraction, pocket-k-fold, 2, CGNN, 1
   run_extraction, pocket-k-fold, 2, DTI, 1
   run_extraction, pocket-k-fold, 4, CGNN-3D, 1
   run_extraction, pocket-k-fold, 4, DTI, 1
   run_extraction, pocket-k-fold, 4, CGNN, 1
   run_extraction, pocket-k-fold, 6, CGNN-3D, 1
   run_extraction, pocket-k-fold, 6, CGNN, 1
   run_extraction, pocket-k-fold, 6, DTI, 1
)
