universe = docker
docker_image = gjoschka/kinodata3d-b0:2.3.0-cuda12.1
executable = generate_prob_dataset.sh
arguments = $(script) --split_type $(split) --rmsd_cutoff $(rmsd) --gnn_model_type $(model)
output = gen_prob_ds.$(ClusterId).$(ProcId).out
error = gen_prob_ds.$(ClusterId).$(ProcId).err
log = gen_prob_ds.$(ClusterId).log
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
request_GPUs = 1
request_CPUs = 16
request_memory = 64G
requirements = UidDomain == "cs.uni-saarland.de"
+WantScratchMounted = true
queue script, split, rmsd, gnn from (
   generate_prob_ds, random-k-fold, 2, CGNN-3D,
   generate_prob_ds, scaffold-k-fold, 2, CGNN-3D,
   generate_prob_ds, pocket-k-fold, 2, CGNN-3D,
)