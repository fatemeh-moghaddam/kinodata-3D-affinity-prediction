universe = docker
docker_image = gjoschka/kinodata3d-pt2.5.1-cu121-cudnn9
executable = generate_prob_dataset.sh
arguments = $(script) $(split) $(rmsd) $(gnn)
output = gen_scaffold_reps.$(ClusterId).$(ProcId).out
error = gen_scaffold_reps.$(ClusterId).$(ProcId).err
log = gen_scaffold_reps.$(ClusterId).log
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
request_GPUs = 1
request_CPUs = 16
request_memory = 64G
requirements = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted = true
queue script, split, rmsd, gnn from (
   run_extraction, scaffold-k-fold, 2, CGNN-3D
   run_extraction, scaffold-k-fold, 2, DTI
   run_extraction, scaffold-k-fold, 2, CGNN
   run_extraction, scaffold-k-fold, 4, CGNN-3D
   run_extraction, scaffold-k-fold, 4, DTI
   run_extraction, scaffold-k-fold, 4, CGNN
   run_extraction, scaffold-k-fold, 6, CGNN-3D
   run_extraction, scaffold-k-fold, 6, CGNN
   run_extraction, scaffold-k-fold, 6, DTI
)