universe = docker
docker_image = gjoschka/kinodata3d-b0:2.3.0-cuda12.1
executable = affinity_skyline.sh
output = affinity_dscore_skyline.$(ClusterId).$(ProcId).out
error = affinity_dscore_skyline.$(ClusterId).$(ProcId).err
log = affinity_dscore_skyline.$(ClusterId).log
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
request_GPUs = 1
request_CPUs = 16
request_memory = 32G
requirements = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted = true